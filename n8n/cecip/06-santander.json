        228
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.santander_api_url.replace(/\\/$/, '') }}/accounts/{{ $json.santander_cuenta }}/transactions",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "dateFrom",
              "value": "={{ $('Al ejecutarse desde otro workflow').first().json.desde }}"
            },
            {
              "name": "dateTo",
              "value": "={{ $('Al ejecutarse desde otro workflow').first().json.hasta }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "notes": "Completar según el contrato de API con Santander: credencial OAuth2 (client credentials) y, si cambian, la ruta y los nombres de los parámetros de fecha."
    },
    {
      "id": "fabefe01-a107-4e3a-80af-c9540e2b9560",
      "name": "Normalizar movimientos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        228
      ],
      "parameters": {
        "jsCode": "// Convierte la respuesta del banco al formato del ERP: { id, fecha, descripcion, monto (+ crédito / - débito), saldo, referencia, contraparte_nombre, contraparte_cuit }\nconst d = $input.first().json;\nconst crudos = d.transactions?.booked || d.transactions || d.movimientos || d.data || d.items || (Array.isArray(d) ? d : []);\nconst num = (v) => typeof v === 'number' ? v : Number(String(v ?? '').replace(/\\./g, '').replace(',', '.'));\nconst movimientos = (Array.isArray(crudos) ? crudos : []).map((m) => {\n  let monto = num(m.amount?.amount ?? m.transactionAmount?.amount ?? m.amount ?? m.importe ?? m.monto);\n  const tipo = String(m.creditDebitIndicator || m.type || m.tipo || '').toUpperCase();\n  if (/DBIT|DEBIT|DEB/.test(tipo) && monto > 0) monto = -monto;\n  return {\n    id: String(m.transactionId || m.id || m.reference || m.referencia || ''),\n    fecha: String(m.bookingDate || m.valueDate || m.date || m.fecha || '').slice(0, 10),\n    descripcion: String(m.remittanceInformationUnstructured || m.description || m.descripcion || m.concepto || 'Movimiento').slice(0, 300),\n    monto,\n    saldo: m.balanceAfterTransaction?.balanceAmount?.amount ?? m.balance ?? m.saldo ?? null,\n    referencia: m.endToEndId || m.reference || m.referencia || null,\n    contraparte_nombre: m.creditorName || m.debtorName || m.counterpartName || null,\n    contraparte_cuit: m.creditorId || m.debtorId || m.cuit || null,\n  };\n}).filter((m) => m.fecha && Number.isFinite(m.monto) && m.monto !== 0);\nreturn [{ json: { ok: true, movimientos } }];"
      }
    },
    {
      "id": "939ec5d9-c19e-4b77-b863-c3c4b2fa7b68",
