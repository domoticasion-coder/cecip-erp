            {
              "id": "85de7f32-26e4-4e95-8d30-cefb295c3bef",
              "name": "result",
              "type": "object",
              "value": "={{ (() => {\n  const b = $json.body || {};\n  const re = /^\\d{4}-\\d{2}-\\d{2}$/;\n  const errores = [];\n  if (!re.test(String(b.desde || ''))) errores.push('\"desde\" tiene que ser YYYY-MM-DD');\n  if (!re.test(String(b.hasta || ''))) errores.push('\"hasta\" tiene que ser YYYY-MM-DD');\n  if (!errores.length) {\n    const dias = (Date.parse(b.hasta) - Date.parse(b.desde)) / 86400000;\n    if (dias < 0) errores.push('\"desde\" no puede ser posterior a \"hasta\"');\n    if (dias > 92) errores.push('El rango máximo es de 92 días');\n  }\n  if (!/^https:\\/\\//.test(String(b.callback_url || ''))) errores.push('\"callback_url\" tiene que ser una URL https');\n  return errores.length ? { valid: false, validationError: errores.join('; ') } : { valid: true, desde: b.desde, hasta: b.hasta, callback_url: b.callback_url };\n})() }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
