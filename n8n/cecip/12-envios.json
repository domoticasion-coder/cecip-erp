        "path": "cecip-envios",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "be94073a-79d1-4044-bba4-e634f612e83c",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ywg3i5pRizGPhbcD",
          "name": "CeCIP ERP · Clave compartida"
        }
      }
    },
    {
      "id": "810fddb0-8674-4b98-b080-87e7c43b186c",
      "name": "Validar envío",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "1a709345-527b-4c1b-a2ba-3d82e79b1a91",
              "name": "result",
              "type": "object",
              "value": "={{ (() => {\n  const b = $json.body || {};\n  const errores = [];\n  const lista = Array.isArray(b.mensajes) ? b.mensajes : null;\n  if (!lista) errores.push('Falta \"mensajes\"');\n  else if (!lista.length) errores.push('No hay mensajes');\n  else if (lista.length > 5000) errores.push('Máximo 5000 emails por envío');\n  if (!b.from) errores.push('Falta \"from\" (remitente)');\n  if (!/^https:\\/\\//.test(String(b.callback_url || ''))) errores.push('\"callback_url\" tiene que ser una URL https');\n  const malos = (lista || []).filter((m) => !m || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(m.to || '')) || !m.subject || !m.html).length;\n  if (malos) errores.push(malos + ' mensaje(s) sin destinatario válido, asunto o contenido');\n  return errores.length ? { valid: false, validationError: errores.join('; ') } : { valid: true, cantidad: lista.length };\n})() }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
