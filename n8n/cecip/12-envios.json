    {
      "id": "85b57d13-5fb0-4bd6-8d25-33512ce326cd",
      "name": "Armar lotes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        228
      ],
      "parameters": {
        "jsCode": "// Parte la lista en lotes (100 por defecto: el máximo de Resend por llamada)\nconst b = $('Webhook').first().json.body;\nconst c = $('Config').first().json;\nconst tam = Math.max(1, Math.min(100, Number(c.tamano_lote_email) || 100));\nconst out = [];\nfor (let i = 0; i < b.mensajes.length; i += tam) {\n  out.push({ json: { mensajes: b.mensajes.slice(i, i + tam), from: b.from || c.email_remitente, reply_to: b.reply_to || '', pausa_seg: Number(c.pausa_lote_seg) || 2, callback_url: b.callback_url } });\n}\nreturn out;"
      }
    },
