    {
      "id": "4975ca60-6275-411d-8e5e-280a6e5650e5",
      "name": "Leer respuesta de ARCA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        354
      ],
      "parameters": {
        "jsCode": "const e = $('Al ejecutarse desde otro workflow').first().json;\nconst numero = $('Armar solicitud de CAE').first().json.numero;\nconst txt = String($input.first().json.data || '');\nconst todos = (tag) => [...txt.matchAll(new RegExp('<' + tag + '>[\\\\s\\\\S]*?<Code>(\\\\d+)</Code>[\\\\s\\\\S]*?<Msg>([\\\\s\\\\S]*?)</Msg>', 'g'))].map((x) => x[1] + ': ' + x[2]);\nconst resultado = (txt.match(/<Resultado>(\\w)<\\/Resultado>/) || [])[1];\nconst caeNro = (txt.match(/<CAE>(\\d+)<\\/CAE>/) || [])[1];\nconst vto = (txt.match(/<CAEFchVto>(\\d{8})<\\/CAEFchVto>/) || [])[1];\nif (resultado === 'A' && caeNro) {\n  return [{ json: { ok: true, factura_id: e.factura.id, cae: caeNro, cae_vencimiento: vto.slice(0, 4) + '-' + vto.slice(4, 6) + '-' + vto.slice(6), numero, observaciones: todos('Obs').join(' | ') || null } }];\n}\nconst motivo = [...todos('Err'), ...todos('Obs')].join(' | ') || 'ARCA rechazó el comprobante';\nreturn [{ json: { ok: false, factura_id: e.factura.id, error: motivo.slice(0, 480) } }];"
      }
    },
