            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "text/xml; charset=utf-8",
        "body": "={{ $json.xml }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "8bb310bd-cabe-4bc0-9174-c2dece06a590",
      "name": "Armar solicitud de CAE",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        354
      ],
      "parameters": {
        "jsCode": "const e = $('Al ejecutarse desde otro workflow').first().json;\nconst p = $('Armar consulta del último número').first().json;\nconst txt = String($input.first().json.data || '');\nconst err = (txt.match(/<Err>[\\s\\S]*?<Msg>([\\s\\S]*?)<\\/Msg>/) || [])[1];\nif (err) throw new Error('ARCA (último número): ' + err);\nconst ultimo = Number((txt.match(/<CbteNro>(\\d+)<\\/CbteNro>/) || [])[1]);\nif (!Number.isFinite(ultimo)) throw new Error('ARCA no devolvió el último número de comprobante');\nconst f = e.factura, r = e.receptor;\nconst n = ultimo + 1;\nconst fch = (d) => String(d || '').slice(0, 10).replace(/-/g, '');\nconst m = (v) => Number(v || 0).toFixed(2);\nconst esC = Number(f.cbte_tipo) === 11;\nconst idAlic = { 0: 3, 10.5: 4, 21: 5, 27: 6, 5: 8, 2.5: 9 }[Number(f.iva_alicuota)] || 5;\nconst iva = esC || !Number(f.iva) ? '' : '<ar:Iva><ar:AlicIva><ar:Id>' + idAlic + '</ar:Id><ar:BaseImp>' + m(f.neto) + '</ar:BaseImp><ar:Importe>' + m(f.iva) + '</ar:Importe></ar:AlicIva></ar:Iva>';\nconst det = '<ar:FECAEDetRequest>'\n  + '<ar:Concepto>' + (f.concepto_arca || 2) + '</ar:Concepto>'\n  + '<ar:DocTipo>' + (r.doc_tipo || 99) + '</ar:DocTipo><ar:DocNro>' + (r.doc_nro || 0) + '</ar:DocNro>'\n  + '<ar:CbteDesde>' + n + '</ar:CbteDesde><ar:CbteHasta>' + n + '</ar:CbteHasta>'\n  + '<ar:CbteFch>' + fch(f.fecha) + '</ar:CbteFch>'\n  + '<ar:ImpTotal>' + m(f.total) + '</ar:ImpTotal><ar:ImpTotConc>0.00</ar:ImpTotConc>'\n  + '<ar:ImpNeto>' + m(esC ? f.total : f.neto) + '</ar:ImpNeto><ar:ImpOpEx>0.00</ar:ImpOpEx><ar:ImpTrib>0.00</ar:ImpTrib>'\n  + '<ar:ImpIVA>' + m(esC ? 0 : f.iva) + '</ar:ImpIVA>'\n  + '<ar:FchServDesde>' + fch(f.servicio_desde || f.fecha) + '</ar:FchServDesde><ar:FchServHasta>' + fch(f.servicio_hasta || f.fecha) + '</ar:FchServHasta>'\n  + '<ar:FchVtoPago>' + fch(f.vencimiento_pago || f.fecha) + '</ar:FchVtoPago>'\n  + '<ar:MonId>PES</ar:MonId><ar:MonCotiz>1</ar:MonCotiz>'\n  + '<ar:CondicionIVAReceptorId>' + (r.condicion_iva_id || 5) + '</ar:CondicionIVAReceptorId>'\n  + iva + '</ar:FECAEDetRequest>';\nconst xml = '<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:ar=\"http://ar.gov.afip.dif.FEV1/\"><soap:Body>'\n  + '<ar:FECAESolicitar>' + p.auth + '<ar:FeCAEReq><ar:FeCabReq><ar:CantReg>1</ar:CantReg><ar:PtoVta>' + p.pv + '</ar:PtoVta><ar:CbteTipo>' + f.cbte_tipo + '</ar:CbteTipo></ar:FeCabReq>'\n  + '<ar:FeDetReq>' + det + '</ar:FeDetReq></ar:FeCAEReq></ar:FECAESolicitar></soap:Body></soap:Envelope>';\nreturn [{ json: { xml, url: p.url, accion: 'http://ar.gov.afip.dif.FEV1/FECAESolicitar', numero: n } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "0061ec13-8d5f-4ae4-8516-a6c7363b6ec7",
      "name": "ARCA: solicitar CAE",
