    {
      "id": "0a1297ba-4d0d-44ee-b88b-3a405c355b87",
      "name": "Armar consulta del último número",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        354
      ],
      "parameters": {
        "jsCode": "const e = $('Al ejecutarse desde otro workflow').first().json;\nconst tk = $input.first().json;\nconst pv = Number(e.factura.punto_venta || e.emisor.punto_venta);\nif (!pv) throw new Error('Falta el punto de venta de ARCA (cargalo en ERP > Facturación > Conexión)');\nconst cuit = String(e.emisor.cuit || '').replace(/\\D/g, '');\nif (cuit.length !== 11) throw new Error('Falta el CUIT del CeCIP (ERP > Configuración > Institución)');\nconst auth = '<ar:Auth><ar:Token>' + tk.token + '</ar:Token><ar:Sign>' + tk.sign + '</ar:Sign><ar:Cuit>' + cuit + '</ar:Cuit></ar:Auth>';\nconst xml = '<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:ar=\"http://ar.gov.afip.dif.FEV1/\"><soap:Body>'\n  + '<ar:FECompUltimoAutorizado>' + auth + '<ar:PtoVta>' + pv + '</ar:PtoVta><ar:CbteTipo>' + e.factura.cbte_tipo + '</ar:CbteTipo></ar:FECompUltimoAutorizado>'\n  + '</soap:Body></soap:Envelope>';\nconst url = e.ambiente === 'produccion' ? 'https://servicios1.afip.gov.ar/wsfev1/service.asmx' : 'https://wswhomo.afip.gov.ar/wsfev1/service.asmx';\nreturn [{ json: { xml, url, auth, pv, cuit, accion: 'http://ar.gov.afip.dif.FEV1/FECompUltimoAutorizado' } }];"
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "a2f6f62a-8068-4e8c-ac58-9a8e49ceb1f6",
      "name": "ARCA: último comprobante",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1300,
        354
      ],
      "parameters": {
        "method": "POST",
