{
  "name": "CeCIP · Facturas: Recibir lote (webhook)",
  "nodes": [
    {
      "id": "fab62d6b-1790-431b-896d-8c1887de11b2",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        20
      ],
      "parameters": {
        "content": "## CeCIP · Facturas: Recibir lote (webhook)\nWebhook POST /webhook/cecip-facturas (header x-cecip-secret). Recibe { evento:'emitir_lote', callback_url, emisor, facturas:[{factura, receptor}] } o una sola factura ('emitir_factura'). Responde 202 y emite las facturas de a una (en orden, para no pisar la numeración de ARCA), avisando cada resultado al ERP.",
        "width": 520,
        "height": 200,
        "color": 7
      }
    },
    {
      "id": "b6b0962f-08c6-4ca2-b5c9-d6224390f11a",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "cecip-facturas",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "cd3f73bd-655b-4d2b-98d7-c34419992b2d",
      "credentials": {
        "httpHeaderAuth": {
          "id": "ywg3i5pRizGPhbcD",
          "name": "CeCIP ERP · Clave compartida"
        }
      }
    },
    {
      "id": "0958d08c-ea7b-455e-b902-6a0b48c78b33",
      "name": "Validar lote",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        260,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "83627ff8-721a-4389-baec-490ff018f85a",
              "name": "result",
              "type": "object",
              "value": "={{ (() => {\n  const b = $json.body || {};\n  const lista = b.evento === 'emitir_factura' ? [{ factura: b.factura, receptor: b.receptor }] : (Array.isArray(b.facturas) ? b.facturas : null);\n  const errores = [];\n  if (!lista) errores.push('Falta \"facturas\" (lote) o \"factura\" (una sola)');\n  else if (lista.length === 0) errores.push('El lote está vacío');\n  else if (lista.length > 300) errores.push('Máximo 300 facturas por lote');\n  if (!/^https:\\/\\//.test(String(b.callback_url || ''))) errores.push('\"callback_url\" tiene que ser una URL https');\n  if (!b.emisor || typeof b.emisor !== 'object') errores.push('Falta \"emisor\"');\n  (lista || []).forEach((it, i) => {\n    const f = it && it.factura, r = it && it.receptor;\n    if (!f || !/^[0-9a-f-]{36}$/i.test(String(f.id || ''))) errores.push('Factura ' + (i + 1) + ': falta el id');\n    else {\n      if (![1, 6, 11].includes(Number(f.cbte_tipo))) errores.push('Factura ' + (i + 1) + ': tipo de comprobante inválido');\n      if (!(Number(f.total) > 0)) errores.push('Factura ' + (i + 1) + ': el total tiene que ser mayor a 0');\n      if (!/^\\d{4}-\\d{2}-\\d{2}/.test(String(f.fecha || ''))) errores.push('Factura ' + (i + 1) + ': fecha inválida');\n    }\n    if (!r || !r.nombre) errores.push('Factura ' + (i + 1) + ': falta el receptor');\n  });\n  if (errores.length) return { valid: false, validationError: errores.slice(0, 20).join('; '), cantidad: 0 };\n  return { valid: true, cantidad: lista.length, items: lista.map((it) => ({ factura: it.factura, receptor: it.receptor, emisor: b.emisor, callback_url: b.callback_url })) };\n})() }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "c2d732f0-408c-4350-9999-420be7b92392",
