# ---------- Públicas (las ve el navegador) ----------
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# URLs públicas de cada subdominio (se usan para links de emails y retorno de Mercado Pago)
VITE_ERP_URL=https://erp.centrocomercialparana.com.ar
VITE_PORTAL_URL=https://portalsocios.centrocomercialparana.com.ar

# ---------- Privadas (solo servidor / funciones de Vercel) ----------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ERP_URL=https://erp.centrocomercialparana.com.ar
PORTAL_URL=https://portalsocios.centrocomercialparana.com.ar

# Mercado Pago (Tus integraciones > Credenciales de producción > Access Token)
MP_ACCESS_TOKEN=APP_USR-...
# Opcional: clave secreta de webhooks de Mercado Pago (valida la firma de las notificaciones)
MP_WEBHOOK_SECRET=

# Resend (https://resend.com) para envío de emails
RESEND_API_KEY=re_...
EMAIL_FROM=CeCIP Paraná <administracion@centrocomercialparana.com.ar>
EMAIL_REPLY_TO=administracion@centrocomercialparana.com.ar

# Secreto para proteger el cron de recordatorios (Vercel lo envía automáticamente)
CRON_SECRET=una-cadena-larga-y-aleatoria

# ---------- Copiloto IA (Gemini) ----------
GEMINI_API_KEY=
# Opcional: modelo a usar primero (si no, prueba una lista de modelos Flash)
GEMINI_MODEL=

# ---------- n8n: facturación en ARCA y movimientos de Banco Santander ----------
# Webhook del flujo de n8n que emite las facturas en ARCA
N8N_FACTURAS_WEBHOOK_URL=
# Webhook del flujo de n8n que trae los movimientos de Santander (opcional)
N8N_BANCO_WEBHOOK_URL=
# Cupo diario de emails del plan de Resend (gratis = 100; 0 = sin límite, p. ej. plan Pro).
# Los envíos masivos que no entran salen solos los días siguientes (cola de emails).
EMAIL_LIMITE_DIARIO=100
# Emails por día que la cola deja libres para envíos individuales y avisos de acceso
EMAIL_RESERVA_DIARIA=10
# Clave compartida: viaja en el header x-cecip-secret en ambos sentidos
N8N_SECRET=otra-cadena-larga-y-aleatoria

# ---------- ComercIA ----------
# WhatsApp de FactorIA al que llegan los pedidos de informacion (ej. 3434123456)
VITE_FACTORIA_WHATSAPP=

# --- Canales: WhatsApp (Evolution API) y emails entrantes (IMAP) ---
# Instancia "CECIP" en el servidor de Evolution (el mismo del ERP del IEC)
EVOLUTION_API_URL=http://149.50.147.172:3900
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=CECIP
# Secreto que va en la URL del webhook de Evolution (cualquier texto largo al azar)
WHATSAPP_WEBHOOK_SECRET=
# Clave para cifrar la contraseña de la casilla de email (texto largo al azar, 32+ caracteres)
CANALES_CLAVE=
# CRON_SECRET (ya existente) también lo usa n8n para /api/canales/cron cada 5 minutos
